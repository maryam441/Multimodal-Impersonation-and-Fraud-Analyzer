{
  "manifest_version": 3,
  "name": "Sentinel Ambient Shield - Fraud & Impersonation Guardian",
  "version": "3.1.0",
  "description": "Enterprise AI shield monitoring WhatsApp Web, Gmail, and Web URLs for fraud, bank impersonation, and OTP theft with 1-click FIA Cybercrime reporting.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Sentinel Ambient Shield - Anti-Fraud Guardian"
  },
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content_whatsapp.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content_email.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content_web.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
