# Multimodal Impersonation & Fraud Analyzer - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Application Environment
APP_ENV=development
APP_NAME="Multimodal Impersonation & Fraud Analyzer"
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend API Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database Configuration (PostgreSQL / SQLite fallback for local test)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mifa_db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Storage & Evidence Retention
EVIDENCE_UPLOAD_DIR=./uploads
EVIDENCE_RETENTION_HOURS=24
AUTO_PURGE_EXPIRED=True

# Modality Feature Toggles
ENABLE_VOICE_MODALITY=True
ENABLE_MESSAGE_MODALITY=True
ENABLE_CONVERSATION_MODALITY=True
ENABLE_URL_MODALITY=True
ENABLE_PHONE_MODALITY=True

# External Reputation Provider Settings (Human-in-the-loop gated)
ENABLE_EXTERNAL_PHONE_LOOKUP=False
ENABLE_LIVE_URL_FETCHING=False

# Grounded RAG & LLM Assistant (Optional)
LLM_PROVIDER=offline_fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
