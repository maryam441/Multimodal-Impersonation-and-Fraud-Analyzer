{
  "expo": {
    "name": "Sentinel Shield",
    "slug": "sentinel-mobile-shield",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sentinel.mobileshield",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sentinel Shield uses the microphone only during active live screening to analyze synthetic voice anomalies in real time.",
        "UIBackgroundModes": ["fetch", "remote-notification", "audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "com.sentinel.mobileshield",
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
